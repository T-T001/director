# Reuse waoowaoo's existing infrastructure services
# Make sure the waoowaoo Docker stack is already running.

# Backend
DIRECTOR_BACKEND_PORT=18000
DIRECTOR_FRONTEND_PORT=15173
DIRECTOR_CORS_ORIGINS=http://localhost:15173
DIRECTOR_ACCESS_TOKEN_EXPIRE_MINUTES=120
DIRECTOR_REFRESH_TOKEN_EXPIRE_DAYS=30
DIRECTOR_JWT_SECRET=change-me-to-a-random-secret
DIRECTOR_REFRESH_COOKIE_NAME=director_refresh_token

# Reused MySQL / Redis / MinIO from waoowaoo
DIRECTOR_DATABASE_URL=mysql+pymysql://root:waoowaoo123@localhost:13306/director
DIRECTOR_REDIS_URL=redis://127.0.0.1:16379/0
DIRECTOR_MINIO_ENDPOINT=http://localhost:19000
DIRECTOR_MINIO_ACCESS_KEY=minioadmin
DIRECTOR_MINIO_SECRET_KEY=minioadmin
DIRECTOR_MINIO_BUCKET=director
DIRECTOR_MINIO_REGION=us-east-1
DIRECTOR_MINIO_SECURE=false

# Frontend
VITE_API_BASE_URL=http://localhost:18000/api
